# content-scout — copy to .env and fill values. See ENV.md for full descriptions.

ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://scout:scout@localhost:5432/content_scout
REDIS_URL=redis://localhost:6379/0

# ≥32 random chars: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000

# Apify (IG scraping)
APIFY_API_TOKEN=
APIFY_IG_ACTOR_ID=

# Anthropic (summaries)
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-haiku-4-5-20251001
SUMMARY_CONCURRENCY=5

# Use fixture scraper instead of Apify (local/dev only)
USE_MOCK_PLATFORM=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
